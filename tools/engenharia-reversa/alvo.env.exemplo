# Endereços da aplicação de referência usados pela coleta do FOCO_02.
#
# Este arquivo é um MODELO. Copie para `alvo.env` (que está no .gitignore) e
# preencha com os valores lidos na aba Network do DevTools ao abrir um canal ao
# vivo. Os endereços reais não entram no repositório: a diretriz da disciplina
# proíbe nomear a fonte de inspiração (não-escopo FE06 do Escopo do Produto).
#
# Onde ler cada valor, no DevTools da página de um canal ao vivo:
#   GQL_URL     -> requisição POST cujo corpo contém "PlaybackAccessToken"
#   CLIENT_ID   -> cabeçalho "Client-Id" dessa mesma requisição
#   QUERY_HASH  -> campo extensions.persistedQuery.sha256Hash do corpo dela
#   USHER_URL   -> prefixo da requisição do manifesto mestre (.m3u8), sem o
#                  "<canal>.m3u8" final e sem a query string

GQL_URL="https://<host-da-api>/gql"
CLIENT_ID="<client-id-publico-do-cliente-web>"
QUERY_HASH="<hash-sha256-da-consulta-persistida>"
USHER_URL="https://<host-do-balanceador>/api/channel/hls"

# --- marcas a anonimizar antes de versionar as evidências ---
#
# Cada valor abaixo é uma cadeia que identifica a fonte de inspiração e que
# aparece nas capturas de rede. `anonimizar.py` as substitui por rótulos
# genéricos; a tabela publicada está em
# docs/assets/engenharia-reversa/subequipe_01/ANONIMIZACAO.md
#
# Onde ler: os domínios aparecem na coluna Domain da aba Network; os nomes e
# identificadores de canal, na URL da página e nos tópicos de tempo real.

RE_MARCA_PLATAFORMA="<marca-da-plataforma>"
RE_MARCA_CDN_PLATAFORMA="<marca-da-cdn-propria>"
RE_MARCA_CDN_TERCEIRA="<marca-da-cdn-de-terceiro>"
RE_MARCA_PROVEDOR="<marca-do-provedor-de-nuvem>"
RE_MARCA_DOMINIO_ALTERNATIVO="<dominio-alternativo-de-segmentos>"
RE_MARCA_NO_ALTERNATIVO="<marca-do-no-alternativo>"

RE_CANAL_A="<nome-do-primeiro-canal-observado>"
RE_CANAL_B="<nome-do-segundo-canal-observado>"
RE_ID_CANAL_A="<id-numerico-do-primeiro-canal>"
RE_ID_CANAL_B="<id-numerico-do-segundo-canal>"
