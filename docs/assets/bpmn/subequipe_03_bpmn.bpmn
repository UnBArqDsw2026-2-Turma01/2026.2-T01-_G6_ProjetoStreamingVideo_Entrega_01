<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Twitch_Complete_Architecture" targetNamespace="http://unb.br/engenharia/twitch" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collaboration_Twitch">
    <bpmn:participant id="Participant_Client" name="Pool 1: Cliente Web (Navegador do Usuário / Frontend SPA &#38; Mod View)" processRef="Process_Client" />
    <bpmn:participant id="Participant_Backend" name="Pool 2: Backend Central (GraphQL BFF &#38; Defesa Kasada Anti-Bot)" processRef="Process_Backend" />
    <bpmn:participant id="Participant_Edge" name="Pool 3: Camada de Borda (Usher Edge CDN - Entrega Rápida)" processRef="Process_Edge" />
    <bpmn:participant id="Participant_Weaver" name="Pool 4: Fábrica de Vídeo &#38; Ingestão Segura (RTMP Ingest, Twitch DJ Program, Audible Magic &#38; Weaver)" processRef="Process_Weaver" />
    <bpmn:participant id="Participant_TMI" name="Pool 5: Central de Chat em Tempo Real &#38; AutoMod (IRC v3 / TMI, NLP Deep Learning &#38; Quarentena)" processRef="Process_TMI" />
    <bpmn:participant id="Participant_Spade" name="Pool 6: Central de Telemetria e Anti-Fraude (Data Lake Spade &#38; Anti-Viewbot)" processRef="Process_Spade" />
    <bpmn:participant id="Participant_Auth" name="Pool 7: Identidade, Segurança &#38; Gestão de Sessões (OAuth2 PKCE / OIDC / TOTP / WebAuthn / JWT RTR)" processRef="Process_Auth" />
    <bpmn:participant id="Participant_Database" name="Pool 8: Banco de Dados &#38; Persistência (Modelo Relacional de 8 Domínios + Segurança)" processRef="Process_Database" />
    <bpmn:participant id="Participant_Social" name="Pool 9: Relacionamentos Sociais (Follows, Bloqueios, Whispers)" processRef="Process_Social" />
    <bpmn:participant id="Participant_Commerce" name="Pool 10: Monetização &#38; Comércio (Subs Tier 1/2/3, Bits, Emotes &#38; Hype Train)" processRef="Process_Commerce" />
    <bpmn:participant id="Participant_VOD" name="Pool 11: Conteúdo Sob Demanda (VODs com Mute DMCA, Clips, Highlights &#38; VOD CDN)" processRef="Process_VOD" />
    <bpmn:participant id="Participant_GuestStar" name="Pool 12: Guest Star &#38; Colaboração (Sessões, Slots &#38; Co-streaming Multi-Host)" processRef="Process_GuestStar" />
    <bpmn:participant id="Participant_Video_Safety" name="Pool 13: Moderação de Vídeo &#38; IA de Segurança (Computer Vision, Detecção Nudez/Gore &#38; Kill-Switch ⚡)" processRef="Process_Video_Safety" />
    <bpmn:messageFlow id="MF_GQL_Req" name="1. POST /gql (PlaybackAccessToken)" sourceRef="Task_Req_Token" targetRef="Task_Resolve_GQL" />
    <bpmn:messageFlow id="MF_GQL_Res" name="2. Retorno {sig, token}" sourceRef="Task_Mint_Token" targetRef="Task_Req_Token" />
    <bpmn:messageFlow id="MF_Usher_Req" name="3. GET /channel.m3u8?sig=..&#38;token=.." sourceRef="Task_Fetch_Master" targetRef="Task_Validate_HMAC" />
    <bpmn:messageFlow id="MF_Usher_Res" name="4. Master Playlist ABR" sourceRef="Task_Serve_Manifest" targetRef="Task_Fetch_Master" />
    <bpmn:messageFlow id="MF_Video_Chunks" name="5. Chunks MPEG-TS (188B)" sourceRef="Task_Package_TS" targetRef="Task_Download_Segments" />
    <bpmn:messageFlow id="MF_IRC_Handshake" name="6. WebSocket IRC Handshake" sourceRef="Task_Connect_IRC" targetRef="Task_TMI_Receive" />
    <bpmn:messageFlow id="MF_IRC_Stream" name="7. PRIVMSG e PING contínuo" sourceRef="Task_TMI_Fanout" targetRef="Task_IRC_Loop" />
    <bpmn:messageFlow id="MF_Spade_Beacon" name="8. POST /track (Base64)" sourceRef="Task_Send_Spade" targetRef="Task_Ingest_Spade" />
    <bpmn:messageFlow id="MF_Auth_Request" name="9. Login OAuth2 + PKCE" sourceRef="Task_Init_SPA" targetRef="Task_Login_OAuth" />
    <bpmn:messageFlow id="MF_Auth_Response" name="10. JWT (RS256) + Refresh Token" sourceRef="Task_Issue_JWT_RTR" targetRef="Task_Init_SPA" />
    <bpmn:messageFlow id="MF_Auth_DB" name="11. Persistir Sessão &#38; 2FA" sourceRef="Task_Issue_JWT_RTR" targetRef="Task_DB_Users" />
    <bpmn:messageFlow id="MF_Auth_Redis" name="12. Blacklist de Token" sourceRef="Task_Revoke_Blacklist" targetRef="Task_DB_Users" />
    <bpmn:messageFlow id="MF_OBS_RTMP" name="13. RTMP Handshake (Stream Key)" sourceRef="Task_Init_SPA" targetRef="Task_Ingest_RTMP" />
    <bpmn:messageFlow id="MF_Ingest_DB_Check" name="14. Validar Key &#38; Status TOS" sourceRef="Task_Validate_StreamKey" targetRef="Task_DB_Users" />
    <bpmn:messageFlow id="MF_Audible_Magic_Match" name="15. Match Fonograma DMCA" sourceRef="Task_Audible_Magic" targetRef="Task_DB_Content" />
    <bpmn:messageFlow id="MF_Held_To_ModView" name="17. Mensagem Retida (Mod View)" sourceRef="Task_Quarantine_Held" targetRef="Task_IRC_Loop" />
    <bpmn:messageFlow id="MF_Mod_Decision" name="18. Decisão do Moderador" sourceRef="Task_IRC_Loop" targetRef="Task_Quarantine_Held" />
    <bpmn:messageFlow id="MF_AutoMod_DB_Log" name="19. Log Quarentena &#38; Strikes" sourceRef="Task_Apply_Chat_Ban" targetRef="Task_DB_Moderation" />
    <bpmn:messageFlow id="MF_Weaver_Keyframes" name="20. Keyframes (2-5s)" sourceRef="Task_Package_TS" targetRef="Task_Extract_Keyframes" />
    <bpmn:messageFlow id="MF_Kill_Stream_Cmd" name="21. KILL STREAM RTMP" sourceRef="Task_Auto_Kill_Stream" targetRef="Task_Ingest_RTMP" />
    <bpmn:messageFlow id="MF_Safety_Strike_DB" name="22. Registrar Strike TOS" sourceRef="Task_Process_Strikes" targetRef="Task_DB_Moderation" />
    <bpmn:messageFlow id="MF_Social_DB" name="23. Persistir Follow/Block" sourceRef="Task_Follow" targetRef="Task_DB_Social" />
    <bpmn:messageFlow id="MF_Commerce_DB" name="24. Persistir Subs/Bits" sourceRef="Task_Activate_Sub" targetRef="Task_DB_Monetization" />
    <bpmn:messageFlow id="MF_VOD_Record" name="25. Gravar Segmentos VOD" sourceRef="Task_Package_TS" targetRef="Task_Record_VOD" />
    <bpmn:messageFlow id="MF_GuestStar_DB" name="26. Persistir Colaborações" sourceRef="Task_Create_GS_Session" targetRef="Task_DB_GuestStar" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Client" isExecutable="false">
    <bpmn:startEvent id="Start_Access_Live" name="Início: Espectador Abre a Transmissão&#10;[Navegador carrega aplicação SPA React]">
      <bpmn:outgoing>Seq_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Init_SPA" name="1.1 Carregar Interface Web &#38; Antifraude&#10;[Baixa SPA React 18 e Executa Prova-de-Trabalho Kasada PoW]">
      <bpmn:incoming>Seq_C1</bpmn:incoming>
      <bpmn:incoming>Seq_Retry</bpmn:incoming>
      <bpmn:outgoing>Seq_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Req_Token" name="1.2 Solicitar Autorização de Acesso ao Vídeo&#10;[Envia Consulta GraphQL PlaybackAccessToken com Hash SHA-256]">
      <bpmn:incoming>Seq_C2</bpmn:incoming>
      <bpmn:outgoing>Seq_C3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Token_Valid" name="Token Autorizado?&#10;[Live Online &#38; Assinatura Válida]">
      <bpmn:incoming>Seq_C3</bpmn:incoming>
      <bpmn:outgoing>Seq_Token_Sim</bpmn:outgoing>
      <bpmn:outgoing>Seq_Retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Fetch_Master" name="1.3 Obter Lista de Qualidades do Vídeo&#10;[GET Master Playlist .m3u8 via Usher Edge CDN]">
      <bpmn:incoming>Seq_Token_Sim</bpmn:incoming>
      <bpmn:outgoing>Seq_C4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Select_ABR" name="1.4 Escolher Qualidade de Vídeo Automática&#10;[Algoritmo ABR Adaptativo de 160p a 1080p60]">
      <bpmn:incoming>Seq_C4</bpmn:incoming>
      <bpmn:outgoing>Seq_C5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Download_Segments" name="1.5 Baixar e Tocar Pedaços de Vídeo&#10;[Buffer Contínuo de Chunks MPEG-TS de 2s via HLS.js]">
      <bpmn:incoming>Seq_C5</bpmn:incoming>
      <bpmn:outgoing>Seq_C6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Connect_IRC" name="1.6 Conectar à Sala de Chat ao Vivo&#10;[Handshake WebSocket IRC v3 com Autenticação de Badges]">
      <bpmn:incoming>Seq_C6</bpmn:incoming>
      <bpmn:outgoing>Seq_C7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IRC_Loop" name="1.7 Exibir Chat, Badges &#38; Painel de Moderação&#10;[Renderização de Mensagens, Emotes e Painel Mod View]">
      <bpmn:incoming>Seq_C7</bpmn:incoming>
      <bpmn:outgoing>Seq_C8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Send_Spade" name="1.8 Enviar Relatório de Audiência e Retenção&#10;[Emissão de Beacon Periódico Base64 via /track para o Spade]">
      <bpmn:incoming>Seq_C8</bpmn:incoming>
      <bpmn:outgoing>Seq_C9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Playback_Active" name="Fim: Transmissão em Reprodução Suave&#10;[Vídeo e Chat Sincronizados com Baixa Latência]">
      <bpmn:incoming>Seq_C9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_C1" sourceRef="Start_Access_Live" targetRef="Task_Init_SPA" />
    <bpmn:sequenceFlow id="Seq_Retry" name="Não (Canal Offline)" sourceRef="Gateway_Token_Valid" targetRef="Task_Init_SPA" />
    <bpmn:sequenceFlow id="Seq_C2" sourceRef="Task_Init_SPA" targetRef="Task_Req_Token" />
    <bpmn:sequenceFlow id="Seq_C3" sourceRef="Task_Req_Token" targetRef="Gateway_Token_Valid" />
    <bpmn:sequenceFlow id="Seq_Token_Sim" name="Sim (Live Online)" sourceRef="Gateway_Token_Valid" targetRef="Task_Fetch_Master" />
    <bpmn:sequenceFlow id="Seq_C4" sourceRef="Task_Fetch_Master" targetRef="Task_Select_ABR" />
    <bpmn:sequenceFlow id="Seq_C5" sourceRef="Task_Select_ABR" targetRef="Task_Download_Segments" />
    <bpmn:sequenceFlow id="Seq_C6" sourceRef="Task_Download_Segments" targetRef="Task_Connect_IRC" />
    <bpmn:sequenceFlow id="Seq_C7" sourceRef="Task_Connect_IRC" targetRef="Task_IRC_Loop" />
    <bpmn:sequenceFlow id="Seq_C8" sourceRef="Task_IRC_Loop" targetRef="Task_Send_Spade" />
    <bpmn:sequenceFlow id="Seq_C9" sourceRef="Task_Send_Spade" targetRef="End_Playback_Active" />
  </bpmn:process>
  <bpmn:process id="Process_Backend" isExecutable="false">
    <bpmn:task id="Task_Kasada_BFF" name="2.1 Defesa de Borda Antirrobô (Kasada)&#10;[Valida Assinatura Biométrica x-kpsdk-ct e Desafio Arkose]">
      <bpmn:outgoing>Seq_B1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Resolve_GQL" name="2.2 Identificar Consulta Pré-Compilada&#10;[Resolução Instantânea APQ via Hash SHA-256 sem Parse de String]">
      <bpmn:incoming>Seq_B1</bpmn:incoming>
      <bpmn:outgoing>Seq_B2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Mint_Token" name="2.3 Gerar Selo Digital de Autorização (Token)&#10;[Empacota Regras de Adblock/Subs e Assina com HMAC-SHA256]">
      <bpmn:incoming>Seq_B2</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Seq_B1" sourceRef="Task_Kasada_BFF" targetRef="Task_Resolve_GQL" />
    <bpmn:sequenceFlow id="Seq_B2" sourceRef="Task_Resolve_GQL" targetRef="Task_Mint_Token" />
  </bpmn:process>
  <bpmn:process id="Process_Edge" isExecutable="false">
    <bpmn:task id="Task_Validate_HMAC" name="3.1 Validação Instantânea na Borda (Edge)&#10;[Verifica Selo HMAC em O(1) sem Bloquear o Banco de Dados]">
      <bpmn:outgoing>Seq_E1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Serve_Manifest" name="3.2 Entregar Playlist de Resoluções (.m3u8)&#10;[Lista de URLs dos Servidores de Vídeo Mais Próximos]">
      <bpmn:incoming>Seq_E1</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Seq_E1" sourceRef="Task_Validate_HMAC" targetRef="Task_Serve_Manifest" />
  </bpmn:process>
  <bpmn:process id="Process_Weaver" isExecutable="false">
    <bpmn:startEvent id="Start_Ingest_RTMP" name="Início: Streamer Inicia a Transmissão&#10;[Software OBS/vMix Conecta ao Servidor de Ingestão]">
      <bpmn:outgoing>Seq_W1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Ingest_RTMP" name="4.1 Receber Sinal de Vídeo Bruto&#10;[Ingestão RTMP :1935 / SRT AES :443 com Stream Key]">
      <bpmn:incoming>Seq_W1</bpmn:incoming>
      <bpmn:outgoing>Seq_W2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Validate_StreamKey" name="4.2 Validar Permissão e Chave de Transmissão&#10;[Checa Integridade live_uid_hmac, 2FA Ativo e Status de TOS]">
      <bpmn:incoming>Seq_W2</bpmn:incoming>
      <bpmn:outgoing>Seq_W3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_StreamKey_Valid" name="Chave e Canal Válidos?">
      <bpmn:incoming>Seq_W3</bpmn:incoming>
      <bpmn:outgoing>Seq_Key_Sim</bpmn:outgoing>
      <bpmn:outgoing>Seq_Key_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject_Stream" name="4.3 Rejeitar Conexão com Erro 403&#10;[Encerra Socket TCP Imediatamente por Chave Inválida ou Ban]">
      <bpmn:incoming>Seq_Key_Nao</bpmn:incoming>
      <bpmn:outgoing>Seq_W_Drop</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Check_DJ" name="4.4 Validação do Programa Twitch DJ&#10;[Checa is_participating_dj vs. Catálogo de Músicas Autorizadas]">
      <bpmn:incoming>Seq_Key_Sim</bpmn:incoming>
      <bpmn:outgoing>Seq_W4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Audible_Magic" name="4.5 Detectar Músicas Protegidas por Direitos&#10;[Extrai Hash Acústico em Tempo Real e Cruza com Base DMCA]">
      <bpmn:incoming>Seq_W4</bpmn:incoming>
      <bpmn:outgoing>Seq_W5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_DMCA_Check" name="Música Protegida sem Direitos?">
      <bpmn:incoming>Seq_W5</bpmn:incoming>
      <bpmn:outgoing>Seq_DMCA_Sim</bpmn:outgoing>
      <bpmn:outgoing>Seq_DMCA_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Transcode_ABR" name="4.7 Criar Versões em Várias Resoluções&#10;[Codifica Vídeo em 1080p, 720p, 480p, 360p, 160p]">
      <bpmn:incoming>Seq_DMCA_Nao</bpmn:incoming>
      <bpmn:incoming>Seq_Mute_Done</bpmn:incoming>
      <bpmn:outgoing>Seq_W6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SSAI_Stitch" name="4.8 Injetar Propagandas Diretamente no Vídeo&#10;[Costura Anúncio no Fluxo Binário com Metadados ID3 TXXX]">
      <bpmn:incoming>Seq_W6</bpmn:incoming>
      <bpmn:outgoing>Seq_W7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Package_TS" name="4.9 Fatiar Vídeo em Pedaços de 2 Segundos&#10;[Gera Arquivos .ts com Relógio de Hardware PCR a 27MHz]">
      <bpmn:incoming>Seq_W7</bpmn:incoming>
      <bpmn:outgoing>Seq_W8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Stream_Active" name="Fim: Fluxo de Mídia Pronto para Entrega&#10;[Segmentos Transcodificados Disponíveis para a CDN]">
      <bpmn:incoming>Seq_W8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Stream_Rejected" name="Fim: Ingestão Abortada&#10;[Transmissão Bloqueada por Segurança]">
      <bpmn:incoming>Seq_W_Drop</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Apply_Mute" name="4.6 Aplicar Silenciamento Seletivo de Áudio&#10;[Alerta Streamer e Marca muted_segments_offset no VOD]">
      <bpmn:incoming>Seq_DMCA_Sim</bpmn:incoming>
      <bpmn:outgoing>Seq_Mute_Done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Seq_W1" sourceRef="Start_Ingest_RTMP" targetRef="Task_Ingest_RTMP" />
    <bpmn:sequenceFlow id="Seq_W2" sourceRef="Task_Ingest_RTMP" targetRef="Task_Validate_StreamKey" />
    <bpmn:sequenceFlow id="Seq_W3" sourceRef="Task_Validate_StreamKey" targetRef="GW_StreamKey_Valid" />
    <bpmn:sequenceFlow id="Seq_Key_Sim" name="Sim" sourceRef="GW_StreamKey_Valid" targetRef="Task_Check_DJ" />
    <bpmn:sequenceFlow id="Seq_Key_Nao" name="Não" sourceRef="GW_StreamKey_Valid" targetRef="Task_Reject_Stream" />
    <bpmn:sequenceFlow id="Seq_W_Drop" sourceRef="Task_Reject_Stream" targetRef="End_Stream_Rejected" />
    <bpmn:sequenceFlow id="Seq_W4" sourceRef="Task_Check_DJ" targetRef="Task_Audible_Magic" />
    <bpmn:sequenceFlow id="Seq_W5" sourceRef="Task_Audible_Magic" targetRef="GW_DMCA_Check" />
    <bpmn:sequenceFlow id="Seq_DMCA_Sim" name="Sim (Violação)" sourceRef="GW_DMCA_Check" targetRef="Task_Apply_Mute" />
    <bpmn:sequenceFlow id="Seq_DMCA_Nao" name="Não" sourceRef="GW_DMCA_Check" targetRef="Task_Transcode_ABR" />
    <bpmn:sequenceFlow id="Seq_Mute_Done" sourceRef="Task_Apply_Mute" targetRef="Task_Transcode_ABR" />
    <bpmn:sequenceFlow id="Seq_W6" sourceRef="Task_Transcode_ABR" targetRef="Task_SSAI_Stitch" />
    <bpmn:sequenceFlow id="Seq_W7" sourceRef="Task_SSAI_Stitch" targetRef="Task_Package_TS" />
    <bpmn:sequenceFlow id="Seq_W8" sourceRef="Task_Package_TS" targetRef="End_Stream_Active" />
  </bpmn:process>
  <bpmn:process id="Process_TMI" isExecutable="false">
    <bpmn:task id="Task_TMI_Receive" name="5.1 Ingestão WebSocket TMI do Chat&#10;[Recebe Mensagem IRC v3 e Extrai Badges e Metadados]">
      <bpmn:outgoing>Seq_T1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AutoMod_NLP" name="5.2 Analisar Mensagem com IA (AutoMod NLP)&#10;[Classificador Neural Detecta Toxicidade, Assédio e Leet-Speak]">
      <bpmn:incoming>Seq_T1</bpmn:incoming>
      <bpmn:outgoing>Seq_T2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Suspicious_User" name="5.3 Detectar Evasão de Banimento no Chat&#10;[Suspicious User ML: Cruza Fingerprint de Hardware e Subnet IP]">
      <bpmn:incoming>Seq_T2</bpmn:incoming>
      <bpmn:outgoing>Seq_T3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_AutoMod_Risk" name="Severidade do Risco da Mensagem?">
      <bpmn:incoming>Seq_T3</bpmn:incoming>
      <bpmn:outgoing>Seq_Risk_Low</bpmn:outgoing>
      <bpmn:outgoing>Seq_Risk_High</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_TMI_Fanout" name="5.4 Distribuir Mensagem para Todos no Chat&#10;[Roteamento em Memória O(1) para 100k+ Pessoas]">
      <bpmn:incoming>Seq_Risk_Low</bpmn:incoming>
      <bpmn:incoming>Seq_Mod_Approved</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_Quarantine_Held" name="5.5 Reter Mensagem Suspeita em Quarentena&#10;[Oculta do Chat Público e Despacha para o Mod View]">
      <bpmn:incoming>Seq_Risk_High</bpmn:incoming>
      <bpmn:outgoing>Seq_T_Mod</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Mod_Decision" name="Decisão do Moderador?">
      <bpmn:incoming>Seq_T_Mod</bpmn:incoming>
      <bpmn:outgoing>Seq_Mod_Approved</bpmn:outgoing>
      <bpmn:outgoing>Seq_Mod_Denied</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Apply_Chat_Ban" name="5.6 Aplicar Punição ao Usuário Infrator&#10;[Timeout Temporário de 10m ou Ban Permanente do Canal]">
      <bpmn:incoming>Seq_Mod_Denied</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Seq_T1" sourceRef="Task_TMI_Receive" targetRef="Task_AutoMod_NLP" />
    <bpmn:sequenceFlow id="Seq_T2" sourceRef="Task_AutoMod_NLP" targetRef="Task_Suspicious_User" />
    <bpmn:sequenceFlow id="Seq_T3" sourceRef="Task_Suspicious_User" targetRef="GW_AutoMod_Risk" />
    <bpmn:sequenceFlow id="Seq_Risk_Low" name="Baixo Risco" sourceRef="GW_AutoMod_Risk" targetRef="Task_TMI_Fanout" />
    <bpmn:sequenceFlow id="Seq_Risk_High" name="Alto Risco" sourceRef="GW_AutoMod_Risk" targetRef="Task_Quarantine_Held" />
    <bpmn:sequenceFlow id="Seq_Mod_Approved" name="Aprovar" sourceRef="GW_Mod_Decision" targetRef="Task_TMI_Fanout" />
    <bpmn:sequenceFlow id="Seq_T_Mod" sourceRef="Task_Quarantine_Held" targetRef="GW_Mod_Decision" />
    <bpmn:sequenceFlow id="Seq_Mod_Denied" name="Recusar" sourceRef="GW_Mod_Decision" targetRef="Task_Apply_Chat_Ban" />
  </bpmn:process>
  <bpmn:process id="Process_Spade" isExecutable="false">
    <bpmn:task id="Task_Ingest_Spade" name="6.1 Processar Métricas e Bloquear Viewbots&#10;[Auditoria de Minutos Assistidos, Foco da Janela e Anti-Bot]" />
  </bpmn:process>
  <bpmn:process id="Process_Auth" isExecutable="false">
    <bpmn:startEvent id="Start_Auth" name="Início: Usuário Inicia Autenticação&#10;[Início do Fluxo de Login Seguro]">
      <bpmn:outgoing>Seq_Auth1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Register_Account" name="7.1 Registro de Conta com Hash Forte&#10;[Criptografia Argon2id + users, user_roles]">
      <bpmn:incoming>Seq_Auth1</bpmn:incoming>
      <bpmn:outgoing>Seq_Auth2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Login_OAuth" name="7.2 Login OAuth2 com Proteção PKCE&#10;[Desafio SHA-256 via OpenID Connect sem Expor Credenciais]">
      <bpmn:incoming>Seq_Auth2</bpmn:incoming>
      <bpmn:outgoing>Seq_Auth3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Val_Creds_Bloom" name="7.3 Validar Senha contra Base de Vazamentos&#10;[Consulta Instantânea em Bloom Filter de Senhas Expostas]">
      <bpmn:incoming>Seq_Auth3</bpmn:incoming>
      <bpmn:outgoing>Seq_Auth4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_2FA_Enabled" name="Autenticação em 2 Etapas (2FA) Ativa?">
      <bpmn:incoming>Seq_Auth4</bpmn:incoming>
      <bpmn:outgoing>Seq_Auth5_Sim</bpmn:outgoing>
      <bpmn:outgoing>Seq_Auth5_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Verify_2FA" name="7.4 Validar Segundo Fator de Autenticação&#10;[Checa Código TOTP RFC 6238, Passkey FIDO2 ou SMS]">
      <bpmn:incoming>Seq_Auth5_Sim</bpmn:incoming>
      <bpmn:outgoing>Seq_Auth6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Issue_JWT_RTR" name="7.5 Emitir Tokens de Acesso com Rotação (RTR)&#10;[Access Token RS256 de 4h + Refresh Token Rotativo]">
      <bpmn:incoming>Seq_Auth6</bpmn:incoming>
      <bpmn:incoming>Seq_Auth5_Nao</bpmn:incoming>
      <bpmn:outgoing>Seq_Auth7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Revoke_Blacklist" name="7.6 Gestão de Sessões &#38; Revogação Distribuída&#10;[Atualiza auth_sessions e Blacklist no Redis Cluster]">
      <bpmn:incoming>Seq_Auth7</bpmn:incoming>
      <bpmn:outgoing>Seq_Auth8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Auth" name="Fim: Sessão Autenticada com Sucesso&#10;[Usuário Conectado e Autorizado]">
      <bpmn:incoming>Seq_Auth8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_Auth1" sourceRef="Start_Auth" targetRef="Task_Register_Account" />
    <bpmn:sequenceFlow id="Seq_Auth2" sourceRef="Task_Register_Account" targetRef="Task_Login_OAuth" />
    <bpmn:sequenceFlow id="Seq_Auth3" sourceRef="Task_Login_OAuth" targetRef="Task_Val_Creds_Bloom" />
    <bpmn:sequenceFlow id="Seq_Auth4" sourceRef="Task_Val_Creds_Bloom" targetRef="GW_2FA_Enabled" />
    <bpmn:sequenceFlow id="Seq_Auth5_Sim" name="Sim" sourceRef="GW_2FA_Enabled" targetRef="Task_Verify_2FA" />
    <bpmn:sequenceFlow id="Seq_Auth5_Nao" name="Não (Sem 2FA)" sourceRef="GW_2FA_Enabled" targetRef="Task_Issue_JWT_RTR" />
    <bpmn:sequenceFlow id="Seq_Auth6" sourceRef="Task_Verify_2FA" targetRef="Task_Issue_JWT_RTR" />
    <bpmn:sequenceFlow id="Seq_Auth7" sourceRef="Task_Issue_JWT_RTR" targetRef="Task_Revoke_Blacklist" />
    <bpmn:sequenceFlow id="Seq_Auth8" sourceRef="Task_Revoke_Blacklist" targetRef="End_Auth" />
  </bpmn:process>
  <bpmn:process id="Process_Database" isExecutable="false">
    <bpmn:task id="Task_DB_Users" name="8.1 Usuários, Sessões &#38; Chaves de Ingestão&#10;[users, user_roles, auth_sessions, 2fa_configs, stream_keys]" />
    <bpmn:task id="Task_DB_Games" name="8.2 Catálogo de Jogos &#38; Transmissões ao Vivo&#10;[games, streams, costream_details, ccl_records]" />
    <bpmn:task id="Task_DB_Taxonomy" name="8.3 Taxonomia, Tags &#38; Classificação Etária&#10;[tags, freeform_tags, content_classification_labels]" />
    <bpmn:task id="Task_DB_Monetization" name="8.4 Monetização, Assinaturas &#38; Moeda Virtual&#10;[subscription_products, emote_sets, emotes, bits]" />
    <bpmn:task id="Task_DB_GuestStar" name="8.5 Sessões Colaborativas &#38; Guest Star&#10;[guest_star_sessions, guest_star_slots, collaborations]" />
    <bpmn:task id="Task_DB_Content" name="8.6 Conteúdo Gravado, VODs &#38; Trilha DMCA&#10;[vods, clips, highlights, muted_segments_offset]" />
    <bpmn:task id="Task_DB_Social" name="8.7 Relacionamentos Sociais &#38; Mensagens Privadas&#10;[follows, blocks, whispers]" />
    <bpmn:task id="Task_DB_Moderation" name="8.8 Moderação, Quarentena &#38; Sanções TOS&#10;[automod_rules, held_messages, moderation_strikes]" />
  </bpmn:process>
  <bpmn:process id="Process_Social" isExecutable="false">
    <bpmn:startEvent id="Start_Social" name="Início: Ação Social Solicitada&#10;[Interação entre Usuários]">
      <bpmn:outgoing>Seq_Soc1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Follow" name="9.1 Seguir ou Deixar de Seguir Canal&#10;[follows(follower_id, followed_id, created_at)]">
      <bpmn:incoming>Seq_Soc1</bpmn:incoming>
      <bpmn:outgoing>Seq_Soc2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Block" name="9.2 Bloquear ou Desbloquear Usuário&#10;[blocks(blocker_id, blocked_id)]">
      <bpmn:incoming>Seq_Soc2</bpmn:incoming>
      <bpmn:outgoing>Seq_Soc3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Blocked" name="Destinatário Bloqueou o Remetente?">
      <bpmn:incoming>Seq_Soc3</bpmn:incoming>
      <bpmn:outgoing>Seq_Soc4_Nao</bpmn:outgoing>
      <bpmn:outgoing>Seq_Soc4_Sim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Whisper" name="9.3 Enviar Mensagem Privada (Whisper)&#10;[Roteamento P2P via Servidores TMI / API Privada]">
      <bpmn:incoming>Seq_Soc4_Nao</bpmn:incoming>
      <bpmn:outgoing>Seq_Soc5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Social" name="Fim: Ação Social Processada com Sucesso&#10;[Operação Registrada no Sistema]">
      <bpmn:incoming>Seq_Soc5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Blocked" name="Fim: Interação Bloqueada&#10;[Mensagem Privada Não Entregue]">
      <bpmn:incoming>Seq_Soc4_Sim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_Soc1" sourceRef="Start_Social" targetRef="Task_Follow" />
    <bpmn:sequenceFlow id="Seq_Soc2" sourceRef="Task_Follow" targetRef="Task_Block" />
    <bpmn:sequenceFlow id="Seq_Soc3" sourceRef="Task_Block" targetRef="GW_Blocked" />
    <bpmn:sequenceFlow id="Seq_Soc4_Nao" name="Não" sourceRef="GW_Blocked" targetRef="Task_Whisper" />
    <bpmn:sequenceFlow id="Seq_Soc4_Sim" name="Sim (Bloqueado)" sourceRef="GW_Blocked" targetRef="End_Blocked" />
    <bpmn:sequenceFlow id="Seq_Soc5" sourceRef="Task_Whisper" targetRef="End_Social" />
  </bpmn:process>
  <bpmn:process id="Process_Commerce" isExecutable="false">
    <bpmn:startEvent id="Start_Commerce" name="Início: Ação de Compra ou Inscrição&#10;[Apoio Financeiro ao Criador]">
      <bpmn:outgoing>Seq_Com1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Subscribe" name="10.1 Processar Inscrição no Canal (Sub)&#10;[subscription_products: Tier 1/2/3, Prime Gaming, Turbo]">
      <bpmn:incoming>Seq_Com1</bpmn:incoming>
      <bpmn:outgoing>Seq_Com2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Payment" name="Pagamento Aprovado pela Operadora?">
      <bpmn:incoming>Seq_Com2</bpmn:incoming>
      <bpmn:outgoing>Seq_Com3_Sim</bpmn:outgoing>
      <bpmn:outgoing>Seq_Com3_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Activate_Sub" name="10.2 Ativar Benefícios de Assinante&#10;[Libera Emblemas, Live sem Anúncios e Status Sub]">
      <bpmn:incoming>Seq_Com3_Sim</bpmn:incoming>
      <bpmn:outgoing>Seq_Com4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Emotes" name="10.3 Carregar Emotes Exclusivos do Canal&#10;[emote_sets, emotes(token, asset_type)]">
      <bpmn:incoming>Seq_Com4</bpmn:incoming>
      <bpmn:outgoing>Seq_Com5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Bits" name="10.4 Processar Compra de Bits &#38; Cheers&#10;[Moeda Virtual, Animação de Cheer e Hype Train]">
      <bpmn:incoming>Seq_Com5</bpmn:incoming>
      <bpmn:outgoing>Seq_Com6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Commerce" name="Fim: Compra Processada com Sucesso&#10;[Benefícios Vinculados à Conta]">
      <bpmn:incoming>Seq_Com6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Payment_Failed" name="Fim: Pagamento Rejeitado&#10;[Falha na Operadora de Pagamentos]">
      <bpmn:incoming>Seq_Com3_Nao</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_Com1" sourceRef="Start_Commerce" targetRef="Task_Subscribe" />
    <bpmn:sequenceFlow id="Seq_Com2" sourceRef="Task_Subscribe" targetRef="GW_Payment" />
    <bpmn:sequenceFlow id="Seq_Com3_Sim" name="Sim" sourceRef="GW_Payment" targetRef="Task_Activate_Sub" />
    <bpmn:sequenceFlow id="Seq_Com3_Nao" name="Não (Recusado)" sourceRef="GW_Payment" targetRef="End_Payment_Failed" />
    <bpmn:sequenceFlow id="Seq_Com4" sourceRef="Task_Activate_Sub" targetRef="Task_Emotes" />
    <bpmn:sequenceFlow id="Seq_Com5" sourceRef="Task_Emotes" targetRef="Task_Bits" />
    <bpmn:sequenceFlow id="Seq_Com6" sourceRef="Task_Bits" targetRef="End_Commerce" />
  </bpmn:process>
  <bpmn:process id="Process_VOD" isExecutable="false">
    <bpmn:startEvent id="Start_VOD" name="Início: Evento de Conteúdo Gravado&#10;[Transmissão Encerrada ou Criação de Clip]">
      <bpmn:outgoing>Seq_VOD1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_VOD_Enabled" name="Gravação de VOD Ativada no Canal?">
      <bpmn:incoming>Seq_VOD1</bpmn:incoming>
      <bpmn:outgoing>Seq_VOD2_Sim</bpmn:outgoing>
      <bpmn:outgoing>Seq_VOD2_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Record_VOD" name="11.1 Gravar VOD Automático com Mute DMCA&#10;[Arquiva Vídeo com Segmentos Protegidos Silenciados]">
      <bpmn:incoming>Seq_VOD2_Sim</bpmn:incoming>
      <bpmn:outgoing>Seq_VOD3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Create_Clip" name="11.2 Gerar Clip Curto do Momento (5-60s)&#10;[clips(broadcaster_id, creator_id, vod_offset)]">
      <bpmn:incoming>Seq_VOD3</bpmn:incoming>
      <bpmn:outgoing>Seq_VOD4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Create_Highlight" name="11.3 Criar Destaque (Highlight) Editado&#10;[Edição dos Melhores Momentos pelo Streamer]">
      <bpmn:incoming>Seq_VOD4</bpmn:incoming>
      <bpmn:outgoing>Seq_VOD5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Transcode_VOD" name="11.4 Transcodificar &#38; Distribuir na CDN&#10;[Gera Playlist ABR .m3u8 para Visualização Sob Demanda]">
      <bpmn:incoming>Seq_VOD5</bpmn:incoming>
      <bpmn:outgoing>Seq_VOD6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_VOD" name="Fim: Conteúdo Disponível na Biblioteca&#10;[VOD ou Clip Acessível para o Público]">
      <bpmn:incoming>Seq_VOD6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_VOD_Disabled" name="Fim: Gravação Ignorada&#10;[VODs Desativados nas Opções do Canal]">
      <bpmn:incoming>Seq_VOD2_Nao</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_VOD1" sourceRef="Start_VOD" targetRef="GW_VOD_Enabled" />
    <bpmn:sequenceFlow id="Seq_VOD2_Sim" name="Sim" sourceRef="GW_VOD_Enabled" targetRef="Task_Record_VOD" />
    <bpmn:sequenceFlow id="Seq_VOD2_Nao" name="Não" sourceRef="GW_VOD_Enabled" targetRef="End_VOD_Disabled" />
    <bpmn:sequenceFlow id="Seq_VOD3" sourceRef="Task_Record_VOD" targetRef="Task_Create_Clip" />
    <bpmn:sequenceFlow id="Seq_VOD4" sourceRef="Task_Create_Clip" targetRef="Task_Create_Highlight" />
    <bpmn:sequenceFlow id="Seq_VOD5" sourceRef="Task_Create_Highlight" targetRef="Task_Transcode_VOD" />
    <bpmn:sequenceFlow id="Seq_VOD6" sourceRef="Task_Transcode_VOD" targetRef="End_VOD" />
  </bpmn:process>
  <bpmn:process id="Process_GuestStar" isExecutable="false">
    <bpmn:startEvent id="Start_GS" name="Início: Iniciar Sessão Guest Star&#10;[Abertura de Sala para Colaboração ao Vivo]">
      <bpmn:outgoing>Seq_GS1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Create_GS_Session" name="12.1 Criar Sessão Guest Star&#10;[guest_star_sessions(id, host_id)]">
      <bpmn:incoming>Seq_GS1</bpmn:incoming>
      <bpmn:outgoing>Seq_GS2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Manage_Slots" name="12.2 Gerenciar Vagas de Convidados&#10;[guest_star_slots(id, session_id, user_id)]">
      <bpmn:incoming>Seq_GS2</bpmn:incoming>
      <bpmn:outgoing>Seq_GS3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Can_Join" name="Convidado Autorizado a Entrar?">
      <bpmn:incoming>Seq_GS3</bpmn:incoming>
      <bpmn:outgoing>Seq_GS4_Sim</bpmn:outgoing>
      <bpmn:outgoing>Seq_GS4_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Join_Session" name="12.3 Conectar Convidado à Sala&#10;[collaborations(can_drop_in, is_favorite) + WebRTC]">
      <bpmn:incoming>Seq_GS4_Sim</bpmn:incoming>
      <bpmn:outgoing>Seq_GS5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Costream" name="12.4 Transmissão Conjunta Multi-Host&#10;[costream_details(organizer_id, costreamers_count)]">
      <bpmn:incoming>Seq_GS5</bpmn:incoming>
      <bpmn:outgoing>Seq_GS6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_GS" name="Fim: Sessão Colaborativa Ativa&#10;[Painel Multi-Host Transmitindo]">
      <bpmn:incoming>Seq_GS6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_GS_Denied" name="Fim: Entrada Negada&#10;[Permissão Insuficiente ou Sala Cheia]">
      <bpmn:incoming>Seq_GS4_Nao</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_GS1" sourceRef="Start_GS" targetRef="Task_Create_GS_Session" />
    <bpmn:sequenceFlow id="Seq_GS2" sourceRef="Task_Create_GS_Session" targetRef="Task_Manage_Slots" />
    <bpmn:sequenceFlow id="Seq_GS3" sourceRef="Task_Manage_Slots" targetRef="GW_Can_Join" />
    <bpmn:sequenceFlow id="Seq_GS4_Sim" name="Sim" sourceRef="GW_Can_Join" targetRef="Task_Join_Session" />
    <bpmn:sequenceFlow id="Seq_GS4_Nao" name="Não" sourceRef="GW_Can_Join" targetRef="End_GS_Denied" />
    <bpmn:sequenceFlow id="Seq_GS5" sourceRef="Task_Join_Session" targetRef="Task_Costream" />
    <bpmn:sequenceFlow id="Seq_GS6" sourceRef="Task_Costream" targetRef="End_GS" />
  </bpmn:process>
  <bpmn:process id="Process_Video_Safety" isExecutable="false">
    <bpmn:startEvent id="Start_Video_Feed" name="Início: Feed de Mídia Contínuo da Live&#10;[Amostragem em Tempo Real do Fluxo Transmitido]">
      <bpmn:outgoing>Seq_Vid_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Extract_Keyframes" name="13.1 Amostragem Periódica de Keyframes&#10;[Extrai 1 Frame a cada 2 a 5 Segundos]">
      <bpmn:incoming>Seq_Vid_1</bpmn:incoming>
      <bpmn:outgoing>Seq_Vid_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CV_Classifiers" name="13.2 Analisar Frames com Visão Computacional&#10;[IA Detecta Nudez, Gore, Violência, Armas e Terrorismo]">
      <bpmn:incoming>Seq_Vid_2</bpmn:incoming>
      <bpmn:outgoing>Seq_Vid_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Video_Risk_Level" name="Severidade da Violação Visual Detectada?">
      <bpmn:incoming>Seq_Vid_3</bpmn:incoming>
      <bpmn:outgoing>Seq_Vid_Safe</bpmn:outgoing>
      <bpmn:outgoing>Seq_Vid_Critical</bpmn:outgoing>
      <bpmn:outgoing>Seq_Vid_Moderate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Video_Safety_OK" name="13.3 Aprovar Transmissão em Conformidade&#10;[Nenhuma Violação das Diretrizes Encontrada]">
      <bpmn:incoming>Seq_Vid_Safe</bpmn:incoming>
      <bpmn:outgoing>Seq_Vid_End_OK</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Auto_Kill_Stream" name="13.4 Kill-Switch Automático de Emergência (P0)&#10;[Derruba Socket RTMP e Bloqueia Canal Instantaneamente]">
      <bpmn:incoming>Seq_Vid_Critical</bpmn:incoming>
      <bpmn:outgoing>Seq_Vid_To_Strike</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Dispatch_Human_Audit" name="13.5 Fila de Auditoria Humana Urgente 24/7&#10;[Equipe Trust &#38; Safety Analisa Incidente em &#60; 30s]">
      <bpmn:incoming>Seq_Vid_Moderate</bpmn:incoming>
      <bpmn:outgoing>Seq_Vid_Audit_Strike</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Process_Strikes" name="13.6 Aplicação de Sanções e Strikes TOS&#10;[Registra Infração em moderation_strikes: Suspensão ou Ban]">
      <bpmn:incoming>Seq_Vid_To_Strike</bpmn:incoming>
      <bpmn:incoming>Seq_Vid_Audit_Strike</bpmn:incoming>
      <bpmn:outgoing>Seq_Vid_End_Terminated</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Stream_Terminated" name="Fim: Live Encerrada por Violação Grave&#10;[Transmissão Abortada e Canal Suspenso]">
      <bpmn:incoming>Seq_Vid_End_Terminated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Video_Safe" name="Fim: Vídeo Aprovado e Seguro&#10;[Transmissão Continua Normalmente]">
      <bpmn:incoming>Seq_Vid_End_OK</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seq_Vid_1" sourceRef="Start_Video_Feed" targetRef="Task_Extract_Keyframes" />
    <bpmn:sequenceFlow id="Seq_Vid_2" sourceRef="Task_Extract_Keyframes" targetRef="Task_CV_Classifiers" />
    <bpmn:sequenceFlow id="Seq_Vid_3" sourceRef="Task_CV_Classifiers" targetRef="GW_Video_Risk_Level" />
    <bpmn:sequenceFlow id="Seq_Vid_Safe" name="Sem Violação" sourceRef="GW_Video_Risk_Level" targetRef="Task_Video_Safety_OK" />
    <bpmn:sequenceFlow id="Seq_Vid_Critical" name="Crítica P0" sourceRef="GW_Video_Risk_Level" targetRef="Task_Auto_Kill_Stream" />
    <bpmn:sequenceFlow id="Seq_Vid_Moderate" name="Média Suspeita" sourceRef="GW_Video_Risk_Level" targetRef="Task_Dispatch_Human_Audit" />
    <bpmn:sequenceFlow id="Seq_Vid_End_OK" sourceRef="Task_Video_Safety_OK" targetRef="End_Video_Safe" />
    <bpmn:sequenceFlow id="Seq_Vid_To_Strike" sourceRef="Task_Auto_Kill_Stream" targetRef="Task_Process_Strikes" />
    <bpmn:sequenceFlow id="Seq_Vid_Audit_Strike" sourceRef="Task_Dispatch_Human_Audit" targetRef="Task_Process_Strikes" />
    <bpmn:sequenceFlow id="Seq_Vid_End_Terminated" sourceRef="Task_Process_Strikes" targetRef="End_Stream_Terminated" />
  </bpmn:process>
