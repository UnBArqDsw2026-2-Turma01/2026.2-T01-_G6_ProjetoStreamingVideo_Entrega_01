<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_D2b" targetNamespace="http://unb.fga/G7_ProjetoStreamingVideo" exporter="G7 SubEquipe_01 - tools/bpmn/gerador.py" exporterVersion="1.0">
  <bpmn:message id="message_0" name="Fim de transmissão anunciado" />
  <bpmn:message id="message_1" name="Pedido de manifesto de mídia" />
  <bpmn:message id="message_2" name="Manifesto de mídia" />
  <bpmn:message id="message_3" name="Pedido de segmento" />
  <bpmn:message id="message_4" name="Segmento" />
  <bpmn:error id="error_0" name="Falha ao baixar segmento" errorCode="Falha ao baixar segmento" />
  <bpmn:escalation id="escalation_0" name="Reprodução não recuperada" escalationCode="Reprodução não recuperada" />
  <bpmn:dataStore id="d2b_ds_cache_store" name="Cache do PoP de borda" />
  <bpmn:collaboration id="Collab_D2b">
    <bpmn:participant id="d2b_p_player" name="Player de vídeo (expansão do subprocesso de D2)" processRef="d2b_proc_player" />
    <bpmn:participant id="d2b_p_man" name="Plataforma — serviço de manifesto de mídia" processRef="d2b_proc_man" />
    <bpmn:participant id="d2b_p_cdn" name="Rede de distribuição (CDN)" processRef="d2b_proc_cdn" />
    <bpmn:messageFlow id="mf_0" name="pedido de manifesto" sourceRef="d2b_pl" targetRef="d2b_m_start" />
    <bpmn:messageFlow id="mf_1" name="janela de segmentos" sourceRef="d2b_m_end" targetRef="d2b_pl" />
    <bpmn:messageFlow id="mf_2" name="pedido de segmento" sourceRef="d2b_seg" targetRef="d2b_c_start" />
    <bpmn:messageFlow id="mf_3" name="bytes do segmento" sourceRef="d2b_c_end" targetRef="d2b_seg" />
  </bpmn:collaboration>
  <bpmn:process id="d2b_proc_player" isExecutable="false">
    <bpmn:laneSet id="ls_d2b_p_player">
      <bpmn:lane id="d2b_l_ctrl" name="Controle do ciclo">
        <bpmn:flowNodeRef>d2b_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_pl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_gwe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_c_seg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_c_to</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_c_down</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_seg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_b_slow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_b_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_append</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_gwbuf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_abr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_refill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_gwtok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_renew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_gwrec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_endfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_endoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_d_seg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="d2b_l_tel" name="Telemetria">
        <bpmn:flowNodeRef>d2b_tel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_tel_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="d2b_start" name="Ciclo iniciado com a qualidade escolhida">
      <bpmn:outgoing>fl_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="d2b_pl" name="Baixar o manifesto de mídia da qualidade corrente">
      <bpmn:incoming>fl_0</bpmn:incoming>
      <bpmn:incoming>fl_13</bpmn:incoming>
      <bpmn:incoming>fl_15</bpmn:incoming>
      <bpmn:incoming>fl_19</bpmn:incoming>
      <bpmn:outgoing>fl_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="d2b_gwe" name="O que ocorrer primeiro">
      <bpmn:incoming>fl_1</bpmn:incoming>
      <bpmn:outgoing>fl_2</bpmn:outgoing>
      <bpmn:outgoing>fl_3</bpmn:outgoing>
      <bpmn:outgoing>fl_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="d2b_c_seg" name="Manifesto traz segmento novo">
      <bpmn:incoming>fl_2</bpmn:incoming>
      <bpmn:outgoing>fl_5</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="d2b_c_seg_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="d2b_c_to" name="Sem segmento novo por 3× a duração-alvo">
      <bpmn:incoming>fl_3</bpmn:incoming>
      <bpmn:outgoing>fl_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="d2b_c_to_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">PT6S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="d2b_c_down" name="Fim de transmissão anunciado">
      <bpmn:incoming>fl_4</bpmn:incoming>
      <bpmn:outgoing>fl_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d2b_c_down_def" messageRef="message_0" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="d2b_seg" name="Baixar o próximo segmento de ~2 s">
      <bpmn:incoming>fl_5</bpmn:incoming>
      <bpmn:outgoing>fl_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="doa_d2b_seg_0">
        <bpmn:targetRef>d2b_d_seg</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="d2b_b_slow" name="Download passa de 2 s" attachedToRef="d2b_seg" cancelActivity="false">
      <bpmn:outgoing>fl_22</bpmn:outgoing>
      <bpmn:timerEventDefinition id="d2b_b_slow_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">PT2S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="d2b_b_err" name="Erro ao baixar o segmento" attachedToRef="d2b_seg">
      <bpmn:outgoing>fl_17</bpmn:outgoing>
      <bpmn:errorEventDefinition id="d2b_b_err_def" errorRef="error_0" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="d2b_append" name="Anexar ao buffer de mídia do navegador">
      <bpmn:incoming>fl_6</bpmn:incoming>
      <bpmn:outgoing>fl_7</bpmn:outgoing>
      <bpmn:dataInputAssociation id="dia_d2b_append_0">
        <bpmn:sourceRef>d2b_d_seg</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="d2b_gwbuf" name="Buffer acima do alvo?">
      <bpmn:incoming>fl_7</bpmn:incoming>
      <bpmn:outgoing>fl_8</bpmn:outgoing>
      <bpmn:outgoing>fl_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="d2b_abr" name="Avaliar troca de qualidade (ver D3)" calledElement="d3_proc_abr">
      <bpmn:incoming>fl_8</bpmn:incoming>
      <bpmn:outgoing>fl_11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="d2b_refill" name="Pausar e reencher o buffer (travamento visível)">
      <bpmn:incoming>fl_9</bpmn:incoming>
      <bpmn:outgoing>fl_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="d2b_wait" name="Aguardar ~1 duração de segmento">
      <bpmn:incoming>fl_10</bpmn:incoming>
      <bpmn:incoming>fl_11</bpmn:incoming>
      <bpmn:outgoing>fl_12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="d2b_wait_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">PT2S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="d2b_gwtok" name="Token ainda válido?">
      <bpmn:incoming>fl_12</bpmn:incoming>
      <bpmn:outgoing>fl_13</bpmn:outgoing>
      <bpmn:outgoing>fl_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="d2b_renew" name="Renovar o token de reprodução">
      <bpmn:incoming>fl_14</bpmn:incoming>
      <bpmn:outgoing>fl_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="d2b_rec" name="Recuperar reprodução (ver D4)" calledElement="d4_proc_player">
      <bpmn:incoming>fl_16</bpmn:incoming>
      <bpmn:incoming>fl_17</bpmn:incoming>
      <bpmn:outgoing>fl_18</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="d2b_gwrec" name="Reprodução retomada?">
      <bpmn:incoming>fl_18</bpmn:incoming>
      <bpmn:outgoing>fl_19</bpmn:outgoing>
      <bpmn:outgoing>fl_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="d2b_endfail" name="Encerrar com falha">
      <bpmn:incoming>fl_20</bpmn:incoming>
      <bpmn:escalationEventDefinition id="d2b_endfail_def" escalationRef="escalation_0" />
    </bpmn:endEvent>
    <bpmn:endEvent id="d2b_endoff" name="Encerrar o ciclo: canal fora do ar">
      <bpmn:incoming>fl_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="d2b_d_seg" name="Segmento de ~2 s" dataObjectRef="d2b_d_seg_obj">
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="d2b_d_seg_obj" />
    <bpmn:serviceTask id="d2b_tel" name="Registrar risco de esgotamento do buffer">
      <bpmn:incoming>fl_22</bpmn:incoming>
      <bpmn:outgoing>fl_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="d2b_tel_end" name="Telemetria enviada">
      <bpmn:incoming>fl_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_0" sourceRef="d2b_start" targetRef="d2b_pl" />
    <bpmn:sequenceFlow id="fl_1" sourceRef="d2b_pl" targetRef="d2b_gwe" />
    <bpmn:sequenceFlow id="fl_2" sourceRef="d2b_gwe" targetRef="d2b_c_seg" />
    <bpmn:sequenceFlow id="fl_3" sourceRef="d2b_gwe" targetRef="d2b_c_to" />
    <bpmn:sequenceFlow id="fl_4" sourceRef="d2b_gwe" targetRef="d2b_c_down" />
    <bpmn:sequenceFlow id="fl_5" sourceRef="d2b_c_seg" targetRef="d2b_seg" />
    <bpmn:sequenceFlow id="fl_6" sourceRef="d2b_seg" targetRef="d2b_append" />
    <bpmn:sequenceFlow id="fl_7" sourceRef="d2b_append" targetRef="d2b_gwbuf" />
    <bpmn:sequenceFlow id="fl_8" sourceRef="d2b_gwbuf" targetRef="d2b_abr" name="sim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_9" sourceRef="d2b_gwbuf" targetRef="d2b_refill" name="não">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_10" sourceRef="d2b_refill" targetRef="d2b_wait" />
    <bpmn:sequenceFlow id="fl_11" sourceRef="d2b_abr" targetRef="d2b_wait" />
    <bpmn:sequenceFlow id="fl_12" sourceRef="d2b_wait" targetRef="d2b_gwtok" />
    <bpmn:sequenceFlow id="fl_13" sourceRef="d2b_gwtok" targetRef="d2b_pl" name="sim — próxima volta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim — próxima volta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_14" sourceRef="d2b_gwtok" targetRef="d2b_renew" name="não">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_15" sourceRef="d2b_renew" targetRef="d2b_pl" name="retomar o ciclo" />
    <bpmn:sequenceFlow id="fl_16" sourceRef="d2b_c_to" targetRef="d2b_rec" />
    <bpmn:sequenceFlow id="fl_17" sourceRef="d2b_b_err" targetRef="d2b_rec" />
    <bpmn:sequenceFlow id="fl_18" sourceRef="d2b_rec" targetRef="d2b_gwrec" />
    <bpmn:sequenceFlow id="fl_19" sourceRef="d2b_gwrec" targetRef="d2b_pl" name="sim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_20" sourceRef="d2b_gwrec" targetRef="d2b_endfail" name="não">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_21" sourceRef="d2b_c_down" targetRef="d2b_endoff" />
    <bpmn:sequenceFlow id="fl_22" sourceRef="d2b_b_slow" targetRef="d2b_tel" />
    <bpmn:sequenceFlow id="fl_23" sourceRef="d2b_tel" targetRef="d2b_tel_end" />
    <bpmn:textAnnotation id="d2b_n1">
      <bpmn:text>Medição por amostragem a cada 2 s (EV-05): a cada volta entra exatamente 1 segmento novo, e a janela tem 16 segmentos (~32 s). O atraso entre o fim do segmento mais novo e o relógio do cliente ficou entre 1,46 s e 2,37 s.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2b_n1" sourceRef="d2b_pl" targetRef="d2b_n1" associationDirection="None" />
    <bpmn:textAnnotation id="d2b_n2">
      <bpmn:text>Medição (EV-04): 859.724 B em 0,266 s, ~26 Mbit/s contra 3,42 Mbit/s declarados para a faixa. Baixar leva ~13% da duração do segmento — a folga que sustenta o buffer.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2b_n2" sourceRef="d2b_seg" targetRef="d2b_n2" associationDirection="None" />
    <bpmn:textAnnotation id="d2b_n3">
      <bpmn:text>Buffer observado no player: 4,1 s a 5,0 s à frente do ponto exibido (EV-05). Somado ao atraso do manifesto, dá a ordem de 6 a 8 s entre o segmento existir e o espectador vê-lo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2b_n3" sourceRef="d2b_gwbuf" targetRef="d2b_n3" associationDirection="None" />
    <bpmn:textAnnotation id="d2b_n6">
      <bpmn:text>Descer a qualidade é ação preventiva; reencher o buffer já é a falha percebida. Todo o ramo superior existe para que este ramo inferior não seja alcançado.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2b_n6" sourceRef="d2b_refill" targetRef="d2b_n6" associationDirection="None" />
  </bpmn:process>
  <bpmn:process id="d2b_proc_man" isExecutable="false">
    <bpmn:startEvent id="d2b_m_start" name="Pedido de manifesto de mídia">
      <bpmn:outgoing>fl_24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d2b_m_start_def" messageRef="message_1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="d2b_m_build" name="Montar a janela deslizante e as marcações da sessão">
      <bpmn:incoming>fl_24</bpmn:incoming>
      <bpmn:outgoing>fl_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="d2b_m_end" name="Manifesto de mídia devolvido">
      <bpmn:incoming>fl_25</bpmn:incoming>
      <bpmn:messageEventDefinition id="d2b_m_end_def" messageRef="message_2" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_24" sourceRef="d2b_m_start" targetRef="d2b_m_build" />
    <bpmn:sequenceFlow id="fl_25" sourceRef="d2b_m_build" targetRef="d2b_m_end" />
    <bpmn:textAnnotation id="d2b_n4">
      <bpmn:text>O manifesto de mídia veio com cabeçalho de não-cache e marcado como privado (EV-03): ele é montado por sessão porque carrega as marcações de anúncio. Trade-off central: personalizar o manifesto impede cacheá-lo, e cada player volta à plataforma a cada ~2 s.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2b_n4" sourceRef="d2b_m_build" targetRef="d2b_n4" associationDirection="None" />
  </bpmn:process>
  <bpmn:process id="d2b_proc_cdn" isExecutable="false">
    <bpmn:laneSet id="ls_d2b_p_cdn">
      <bpmn:lane id="d2b_l_edge" name="PoP de borda">
        <bpmn:flowNodeRef>d2b_c_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_c_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_c_hit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_c_miss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_c_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_c_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_c_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2b_ds_cache</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="d2b_l_orig" name="Origem / origin shield">
        <bpmn:flowNodeRef>d2b_o_fetch</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="d2b_c_start" name="Pedido de segmento">
      <bpmn:outgoing>fl_26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d2b_c_start_def" messageRef="message_3" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="d2b_c_gw" name="Segmento já está na borda?">
      <bpmn:incoming>fl_26</bpmn:incoming>
      <bpmn:outgoing>fl_27</bpmn:outgoing>
      <bpmn:outgoing>fl_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="d2b_c_hit" name="Servir do cache da borda">
      <bpmn:incoming>fl_27</bpmn:incoming>
      <bpmn:outgoing>fl_32</bpmn:outgoing>
      <bpmn:dataInputAssociation id="dia_d2b_c_hit_0">
        <bpmn:sourceRef>d2b_ds_cache</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d2b_c_miss" name="Buscar o segmento na camada de origem">
      <bpmn:incoming>fl_28</bpmn:incoming>
      <bpmn:outgoing>fl_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d2b_c_store" name="Guardar o segmento na borda">
      <bpmn:incoming>fl_30</bpmn:incoming>
      <bpmn:outgoing>fl_31</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="doa_d2b_c_store_0">
        <bpmn:targetRef>d2b_ds_cache</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="d2b_c_join" name="Entregar">
      <bpmn:incoming>fl_31</bpmn:incoming>
      <bpmn:incoming>fl_32</bpmn:incoming>
      <bpmn:outgoing>fl_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="d2b_c_end" name="Segmento entregue ao player">
      <bpmn:incoming>fl_33</bpmn:incoming>
      <bpmn:messageEventDefinition id="d2b_c_end_def" messageRef="message_4" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="d2b_ds_cache" name="Cache do PoP de borda" dataStoreRef="d2b_ds_cache_store">
    </bpmn:dataStoreReference>
    <bpmn:serviceTask id="d2b_o_fetch" name="Ler o segmento da origem protegida">
      <bpmn:incoming>fl_29</bpmn:incoming>
      <bpmn:outgoing>fl_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="fl_26" sourceRef="d2b_c_start" targetRef="d2b_c_gw" />
    <bpmn:sequenceFlow id="fl_27" sourceRef="d2b_c_gw" targetRef="d2b_c_hit" name="sim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_28" sourceRef="d2b_c_gw" targetRef="d2b_c_miss" name="não">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
