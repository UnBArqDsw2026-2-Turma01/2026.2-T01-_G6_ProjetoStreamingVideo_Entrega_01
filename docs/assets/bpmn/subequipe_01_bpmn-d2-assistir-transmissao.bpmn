<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_D2" targetNamespace="http://unb.fga/G7_ProjetoStreamingVideo" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:message id="message_0" name="Fim de transmissão anunciado" />
  <bpmn:message id="message_1" name="Pedido de token de reprodução" />
  <bpmn:message id="message_2" name="Token de reprodução assinado" />
  <bpmn:message id="message_3" name="Pedido de manifesto mestre" />
  <bpmn:message id="message_4" name="Manifesto mestre" />
  <bpmn:error id="error_0" name="Falha de reprodução" errorCode="Falha de reprodução" />
  <bpmn:escalation id="escalation_0" name="Reprodução não recuperada" escalationCode="Reprodução não recuperada" />
  <bpmn:collaboration id="Collab_D2">
    <bpmn:participant id="d2_p_esp" name="Espectador (cliente web)" processRef="d2_proc_esp" />
    <bpmn:participant id="d2_p_plat" name="Plataforma de streaming" processRef="d2_proc_plat" />
    <bpmn:messageFlow id="mf_0" name="pedido de token" sourceRef="d2_pl_token" targetRef="d2_a_start" />
    <bpmn:messageFlow id="mf_1" name="token + assinatura" sourceRef="d2_a_end" targetRef="d2_pl_token" />
    <bpmn:messageFlow id="mf_2" name="token + assinatura" sourceRef="d2_pl_master" targetRef="d2_w_start" />
    <bpmn:messageFlow id="mf_3" name="manifesto mestre" sourceRef="d2_w_end" targetRef="d2_pl_master" />
    <bpmn:textAnnotation id="d2_n1">
      <bpmn:text>Medição (27/08/2026): TTFB de 253 ms. A resposta carrega as decisões de autorização — bloqueio geográfico, blackout, restrição de qualidade por assinatura e resolução máxima permitida. Evidência EV-01.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2_n1" associationDirection="None" sourceRef="d2_pl_token" targetRef="d2_n1" />
    <bpmn:textAnnotation id="d2_n3">
      <bpmn:text>Medição: TTFB de 250 ms; manifesto mestre com 6 qualidades (1080p60 fonte, 720p60, 480p, 360p, 160p e somente áudio). Evidência EV-02.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2_n3" associationDirection="None" sourceRef="d2_pl_master" targetRef="d2_n3" />
    <bpmn:textAnnotation id="d2_n2">
      <bpmn:text>A autorização é anterior à entrega e independe da CDN: é aqui que a plataforma decide QUAIS qualidades o espectador poderá pedir. Sem token válido não há manifesto.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="d2_n6">
      <bpmn:text>Validade do token medida: 1183 s (~20 min). A renovação é não interruptiva de propósito: interromper o ciclo para renovar credencial custaria rebuffering visível ao espectador.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2_n6" associationDirection="None" sourceRef="d2_pl_renew" targetRef="d2_n6" />
    <bpmn:textAnnotation id="d2_n5">
      <bpmn:text>Este subprocesso concentra o custo de latência do fluxo e roda enquanto a transmissão durar. Detalhado em D2b; a decisão de qualidade dentro dele está em D3 e o tratamento de falha em D4.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2_n5" associationDirection="None" sourceRef="d2_pl_loop" targetRef="d2_n5" />
    <bpmn:textAnnotation id="d2_n4">
      <bpmn:text>O nó de manifesto e a origem observados ficam em regiões diferentes, e o manifesto declara o país do espectador: a escolha do ponto de entrega é feita aqui, não no player. Evidência EV-02.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d2_n2" associationDirection="None" sourceRef="d2_a_rule" targetRef="d2_n2" />
    <bpmn:association id="as_d2_n4" associationDirection="None" sourceRef="d2_w_sel" targetRef="d2_n4" />
  </bpmn:collaboration>
  <bpmn:process id="d2_proc_esp" isExecutable="false">
    <bpmn:laneSet id="ls_d2_p_esp">
      <bpmn:lane id="d2_l_user" name="Espectador">
        <bpmn:flowNodeRef>d2_u_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_u_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="d2_l_spa" name="Aplicação da página (SPA)">
        <bpmn:flowNodeRef>d2_s_end_chat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_s_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_s_end_meta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_s_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_s_meta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_s_chat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="d2_l_player" name="Player de vídeo (MSE + ABR)">
        <bpmn:flowNodeRef>d2_pl_token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_master</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_gw_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_loop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_renew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_gw_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_offline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_end_renew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_end_off</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_pl_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_b_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_b_tok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_b_down</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="d2_u_start" name="Espectador abre a página do canal">
      <bpmn:outgoing>fl_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="d2_s_end_chat" name="Canal de tempo real ativo">
      <bpmn:incoming>fl_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_0" sourceRef="d2_u_start" targetRef="d2_s_load" />
    <bpmn:sequenceFlow id="fl_1" sourceRef="d2_s_load" targetRef="d2_s_par" />
    <bpmn:sequenceFlow id="fl_2" sourceRef="d2_s_par" targetRef="d2_s_meta" />
    <bpmn:sequenceFlow id="fl_3" sourceRef="d2_s_meta" targetRef="d2_s_end_meta" />
    <bpmn:sequenceFlow id="fl_4" sourceRef="d2_s_par" targetRef="d2_s_chat" />
    <bpmn:sequenceFlow id="fl_5" sourceRef="d2_s_chat" targetRef="d2_s_end_chat" />
    <bpmn:sequenceFlow id="fl_6" sourceRef="d2_s_par" targetRef="d2_pl_token" />
    <bpmn:sequenceFlow id="fl_7" sourceRef="d2_pl_token" targetRef="d2_pl_gw_auth" />
    <bpmn:sequenceFlow id="fl_8" name="não" sourceRef="d2_pl_gw_auth" targetRef="d2_pl_block">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_9" name="sim" sourceRef="d2_pl_gw_auth" targetRef="d2_pl_master">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_10" sourceRef="d2_pl_master" targetRef="d2_pl_sel" />
    <bpmn:sequenceFlow id="fl_11" sourceRef="d2_pl_sel" targetRef="d2_pl_loop" />
    <bpmn:sequenceFlow id="fl_12" name="espectador sai do canal" sourceRef="d2_pl_loop" targetRef="d2_u_end" />
    <bpmn:sequenceFlow id="fl_13" sourceRef="d2_b_tok" targetRef="d2_pl_renew" />
    <bpmn:sequenceFlow id="fl_14" sourceRef="d2_pl_renew" targetRef="d2_pl_end_renew" />
    <bpmn:sequenceFlow id="fl_15" sourceRef="d2_b_down" targetRef="d2_pl_offline" />
    <bpmn:sequenceFlow id="fl_16" sourceRef="d2_pl_offline" targetRef="d2_pl_end_off" />
    <bpmn:sequenceFlow id="fl_17" sourceRef="d2_b_err" targetRef="d2_pl_rec" />
    <bpmn:sequenceFlow id="fl_18" sourceRef="d2_pl_rec" targetRef="d2_pl_gw_rec" />
    <bpmn:sequenceFlow id="fl_19" name="sim — retomar o ciclo" sourceRef="d2_pl_gw_rec" targetRef="d2_pl_loop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim — retomar o ciclo</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_20" name="não" sourceRef="d2_pl_gw_rec" targetRef="d2_pl_fail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="d2_s_load" name="Carregar documento e aplicação da página">
      <bpmn:incoming>fl_0</bpmn:incoming>
      <bpmn:outgoing>fl_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="d2_s_end_meta" name="Página do canal montada">
      <bpmn:incoming>fl_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="d2_s_par" name="Inicialização em paralelo">
      <bpmn:incoming>fl_1</bpmn:incoming>
      <bpmn:outgoing>fl_2</bpmn:outgoing>
      <bpmn:outgoing>fl_4</bpmn:outgoing>
      <bpmn:outgoing>fl_6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="d2_pl_token" name="Obter token de reprodução do canal">
      <bpmn:incoming>fl_6</bpmn:incoming>
      <bpmn:outgoing>fl_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d2_s_meta" name="Consultar metadados do canal (consulta persistida)">
      <bpmn:incoming>fl_2</bpmn:incoming>
      <bpmn:outgoing>fl_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="d2_s_chat" name="Sincronizar chat e eventos em tempo real" calledElement="d5_proc_cliente">
      <bpmn:incoming>fl_4</bpmn:incoming>
      <bpmn:outgoing>fl_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="d2_pl_master" name="Obter manifesto mestre com a grade de qualidades">
      <bpmn:incoming>fl_9</bpmn:incoming>
      <bpmn:outgoing>fl_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="d2_pl_sel" name="Escolher a qualidade inicial">
      <bpmn:incoming>fl_10</bpmn:incoming>
      <bpmn:outgoing>fl_11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="d2_pl_gw_auth" name="Reprodução autorizada?">
      <bpmn:incoming>fl_7</bpmn:incoming>
      <bpmn:outgoing>fl_8</bpmn:outgoing>
      <bpmn:outgoing>fl_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="d2_pl_block" name="Exibir motivo do bloqueio ao espectador">
      <bpmn:incoming>fl_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="d2_pl_loop" name="Ciclo de reprodução por segmento (ver D2b)" calledElement="d2b_proc_player">
      <bpmn:incoming>fl_11</bpmn:incoming>
      <bpmn:incoming>fl_19</bpmn:incoming>
      <bpmn:outgoing>fl_12</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="d2_b_err" name="Falha de reprodução" attachedToRef="d2_pl_loop">
      <bpmn:outgoing>fl_17</bpmn:outgoing>
      <bpmn:errorEventDefinition id="d2_b_err_def" errorRef="error_0" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="d2_b_tok" name="A cada 18 min" cancelActivity="false" attachedToRef="d2_pl_loop">
      <bpmn:outgoing>fl_13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="d2_b_tok_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT18M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="d2_pl_renew" name="Renovar token de reprodução">
      <bpmn:incoming>fl_13</bpmn:incoming>
      <bpmn:outgoing>fl_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="d2_b_down" name="Fim de transmissão anunciado" attachedToRef="d2_pl_loop">
      <bpmn:outgoing>fl_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d2_b_down_def" messageRef="message_0" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="d2_pl_rec" name="Recuperar reprodução (ver D4)" calledElement="d4_proc_player">
      <bpmn:incoming>fl_17</bpmn:incoming>
      <bpmn:outgoing>fl_18</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="d2_pl_gw_rec" name="Reprodução retomada?">
      <bpmn:incoming>fl_18</bpmn:incoming>
      <bpmn:outgoing>fl_19</bpmn:outgoing>
      <bpmn:outgoing>fl_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="d2_pl_offline" name="Exibir tela de canal fora do ar">
      <bpmn:incoming>fl_15</bpmn:incoming>
      <bpmn:outgoing>fl_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="d2_pl_end_renew" name="Token renovado sem interromper o vídeo">
      <bpmn:incoming>fl_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="d2_pl_end_off" name="Canal fora do ar">
      <bpmn:incoming>fl_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="d2_pl_fail" name="Encerrar com falha e reportar">
      <bpmn:incoming>fl_20</bpmn:incoming>
      <bpmn:escalationEventDefinition id="d2_pl_fail_def" escalationRef="escalation_0" />
    </bpmn:endEvent>
    <bpmn:endEvent id="d2_u_end" name="Sessão de reprodução encerrada">
      <bpmn:incoming>fl_12</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="d2_proc_plat" isExecutable="false">
    <bpmn:laneSet id="ls_d2_p_plat">
      <bpmn:lane id="d2_l_weaver" name="Balanceador de manifesto">
        <bpmn:flowNodeRef>d2_w_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_w_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_w_sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_w_build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_w_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="d2_l_auth" name="Serviço de autorização de reprodução">
        <bpmn:flowNodeRef>d2_a_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_a_rule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_a_sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2_a_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="d2_a_start" name="Pedido de token recebido">
      <bpmn:outgoing>fl_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d2_a_start_def" messageRef="message_1" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="d2_a_rule" name="Avaliar direitos de reprodução do espectador">
      <bpmn:incoming>fl_21</bpmn:incoming>
      <bpmn:outgoing>fl_22</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="d2_a_sign" name="Emitir token assinado com prazo de validade">
      <bpmn:incoming>fl_22</bpmn:incoming>
      <bpmn:outgoing>fl_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="d2_a_end" name="Token devolvido ao player">
      <bpmn:incoming>fl_23</bpmn:incoming>
      <bpmn:messageEventDefinition id="d2_a_end_def" messageRef="message_2" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_21" sourceRef="d2_a_start" targetRef="d2_a_rule" />
    <bpmn:sequenceFlow id="fl_22" sourceRef="d2_a_rule" targetRef="d2_a_sign" />
    <bpmn:sequenceFlow id="fl_23" sourceRef="d2_a_sign" targetRef="d2_a_end" />
    <bpmn:sequenceFlow id="fl_24" sourceRef="d2_w_start" targetRef="d2_w_val" />
    <bpmn:sequenceFlow id="fl_25" sourceRef="d2_w_val" targetRef="d2_w_sel" />
    <bpmn:sequenceFlow id="fl_26" sourceRef="d2_w_sel" targetRef="d2_w_build" />
    <bpmn:sequenceFlow id="fl_27" sourceRef="d2_w_build" targetRef="d2_w_end" />
    <bpmn:startEvent id="d2_w_start" name="Pedido de manifesto mestre">
      <bpmn:outgoing>fl_24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d2_w_start_def" messageRef="message_3" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="d2_w_val" name="Validar assinatura e prazo do token">
      <bpmn:incoming>fl_24</bpmn:incoming>
      <bpmn:outgoing>fl_25</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="d2_w_sel" name="Selecionar cluster e nó de manifesto por geografia e carga">
      <bpmn:incoming>fl_25</bpmn:incoming>
      <bpmn:outgoing>fl_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d2_w_build" name="Montar manifesto mestre só com as qualidades permitidas">
      <bpmn:incoming>fl_26</bpmn:incoming>
      <bpmn:outgoing>fl_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="d2_w_end" name="Manifesto mestre devolvido">
      <bpmn:incoming>fl_27</bpmn:incoming>
      <bpmn:messageEventDefinition id="d2_w_end_def" messageRef="message_4" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_D2">
      <bpmndi:BPMNShape id="d2_p_esp_di" bpmnElement="d2_p_esp" isHorizontal="true">
        <dc:Bounds x="160" y="110" width="2070" height="1000" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_l_player_di" bpmnElement="d2_l_player" isHorizontal="true">
        <dc:Bounds x="190" y="470" width="2040" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_l_spa_di" bpmnElement="d2_l_spa" isHorizontal="true">
        <dc:Bounds x="190" y="224" width="2040" height="246" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_l_user_di" bpmnElement="d2_l_user" isHorizontal="true">
        <dc:Bounds x="190" y="110" width="2040" height="114" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_u_start_di" bpmnElement="d2_u_start">
        <dc:Bounds x="272" y="134" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="235" y="176" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_s_end_chat_di" bpmnElement="d2_s_end_chat">
        <dc:Bounds x="1072" y="398" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="440" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_s_load_di" bpmnElement="d2_s_load">
        <dc:Bounds x="294" y="256" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_s_end_meta_di" bpmnElement="d2_s_end_meta">
        <dc:Bounds x="1072" y="278" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1051" y="320" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_s_par_di" bpmnElement="d2_s_par">
        <dc:Bounds x="565" y="271" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="551" y="235" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_pl_token_di" bpmnElement="d2_pl_token">
        <dc:Bounds x="520" y="540" width="140" height="80" />
