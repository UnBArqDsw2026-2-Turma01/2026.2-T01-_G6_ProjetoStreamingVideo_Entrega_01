<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_D5" targetNamespace="http://unb.fga/G6_ProjetoStreamingVideo" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:message id="message_0" name="Página do canal montada" />
  <bpmn:message id="message_1" name="Notificação de tópico" />
  <bpmn:message id="message_2" name="Troca de canal" />
  <bpmn:message id="message_3" name="Saída da página" />
  <bpmn:message id="message_4" name="Abertura de conexão de tempo real" />
  <bpmn:message id="message_5" name="Fechamento de conexão" />
  <bpmn:collaboration id="Collab_D5">
    <bpmn:participant id="d5_p_cliente" name="Cliente web — camada de tempo real" processRef="d5_proc_cliente" />
    <bpmn:participant id="d5_p_rt" name="Plataforma — malha de tempo real (publicar/assinar)" processRef="d5_proc_rt" />
    <bpmn:messageFlow id="mf_0" name="abertura da conexão" sourceRef="d5_open" targetRef="d5_s_start" />
    <bpmn:messageFlow id="mf_1" name="saudação da sessão" sourceRef="d5_s_wel" targetRef="d5_wel" />
    <bpmn:messageFlow id="mf_2" name="assinaturas de tópico" sourceRef="d5_sub" targetRef="d5_s_reg" />
    <bpmn:messageFlow id="mf_3" name="cancelamentos + novas assinaturas" sourceRef="d5_resub" targetRef="d5_s_reg" />
    <bpmn:messageFlow id="mf_4" name="evento do tópico" sourceRef="d5_s_fan" targetRef="d5_c_notif" />
    <bpmn:messageFlow id="mf_5" name="keepalive" sourceRef="d5_s_send_ka" targetRef="d5_c_notif" />
    <bpmn:textAnnotation id="d5_n1">
      <bpmn:text>Uma única conexão carrega todos os tópicos do canal: 36 assinaturas foram emitidas em uma só troca de canal e nenhuma segunda conexão foi aberta. É o padrão publicar/assinar do SIG.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="d5_n2">
      <bpmn:text>A saudação observada já traz o intervalo de "keepalive" e uma URL de recuperação pronta: o caminho de reconexão é entregue antes de a falha acontecer. Evidência EV-06.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="d5_n3">
      <bpmn:text>Esta via não passa pela CDN nem pelo buffer do player. O evento de chat chega antes do vídeo correspondente  É o elo mais direto entre o softgoal de latência e o que o espectador sente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="d5_n4">
      <bpmn:text>Na troca de canal foram observados 38 cancelamentos e 36 novas assinaturas na mesma conexão (EV-06): trocar de canal custa assinatura, não conexão — poupa o handshake e o TLS a cada navegação.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d5_n1" associationDirection="None" sourceRef="d5_open" targetRef="d5_n1" />
    <bpmn:association id="as_d5_n2" associationDirection="None" sourceRef="d5_wel" targetRef="d5_n2" />
    <bpmn:association id="as_d5_n4" associationDirection="None" sourceRef="d5_resub" targetRef="d5_n4" />
    <bpmn:association id="as_d5_n3" associationDirection="None" sourceRef="d5_apply" targetRef="d5_n3" />
  </bpmn:collaboration>
  <bpmn:process id="d5_proc_cliente" isExecutable="false">
    <bpmn:laneSet id="ls_d5_p_cliente">
      <bpmn:lane id="d5_l_cli" name="Conexão e assinaturas">
        <bpmn:flowNodeRef>d5_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_wel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_gwe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_resub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_c_nav</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_c_ka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_recover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_c_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_c_notif</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="d5_start" name="Página do canal montada">
      <bpmn:outgoing>fl_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d5_start_def" messageRef="message_0" />
    </bpmn:startEvent>
    <bpmn:sendTask id="d5_open" name="Abrir uma única conexão persistente multiplexada">
      <bpmn:incoming>fl_0</bpmn:incoming>
      <bpmn:outgoing>fl_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="d5_wel" name="Receber a saudação com o intervalo de keepalive e a URL de recuperação">
      <bpmn:incoming>fl_1</bpmn:incoming>
      <bpmn:incoming>fl_11</bpmn:incoming>
      <bpmn:outgoing>fl_2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:eventBasedGateway id="d5_gwe" name="Aguardar o próximo evento">
      <bpmn:incoming>fl_3</bpmn:incoming>
      <bpmn:incoming>fl_9</bpmn:incoming>
      <bpmn:incoming>fl_13</bpmn:incoming>
      <bpmn:outgoing>fl_4</bpmn:outgoing>
      <bpmn:outgoing>fl_5</bpmn:outgoing>
      <bpmn:outgoing>fl_6</bpmn:outgoing>
      <bpmn:outgoing>fl_7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sendTask id="d5_sub" name="Assinar os tópicos do canal">
      <bpmn:incoming>fl_2</bpmn:incoming>
      <bpmn:outgoing>fl_3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:sendTask id="d5_resub" name="Cancelar as assinaturas e assinar as do novo canal">
      <bpmn:incoming>fl_12</bpmn:incoming>
      <bpmn:outgoing>fl_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="d5_c_nav" name="Espectador troca de canal">
      <bpmn:incoming>fl_6</bpmn:incoming>
      <bpmn:outgoing>fl_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d5_c_nav_def" messageRef="message_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="d5_apply" name="Aplicar o evento na interface">
      <bpmn:incoming>fl_8</bpmn:incoming>
      <bpmn:outgoing>fl_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="d5_c_ka" name="Sem keepalive por 15 s">
      <bpmn:incoming>fl_5</bpmn:incoming>
      <bpmn:outgoing>fl_10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="d5_c_ka_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">PT15S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="d5_recover" name="Reconectar pela URL de recuperação">
      <bpmn:incoming>fl_10</bpmn:incoming>
      <bpmn:outgoing>fl_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="d5_c_close" name="Espectador sai da página">
      <bpmn:incoming>fl_7</bpmn:incoming>
      <bpmn:outgoing>fl_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d5_c_close_def" messageRef="message_3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="d5_end" name="Conexão encerrada">
      <bpmn:incoming>fl_14</bpmn:incoming>
      <bpmn:terminateEventDefinition id="d5_end_def" />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="d5_c_notif" name="Notificação de tópico">
      <bpmn:incoming>fl_4</bpmn:incoming>
      <bpmn:outgoing>fl_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d5_c_notif_def" messageRef="message_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="fl_0" sourceRef="d5_start" targetRef="d5_open" />
    <bpmn:sequenceFlow id="fl_1" sourceRef="d5_open" targetRef="d5_wel" />
    <bpmn:sequenceFlow id="fl_11" name="retomar a sessão" sourceRef="d5_recover" targetRef="d5_wel" />
    <bpmn:sequenceFlow id="fl_2" sourceRef="d5_wel" targetRef="d5_sub" />
    <bpmn:sequenceFlow id="fl_3" sourceRef="d5_sub" targetRef="d5_gwe" />
    <bpmn:sequenceFlow id="fl_9" name="voltar a aguardar" sourceRef="d5_apply" targetRef="d5_gwe" />
    <bpmn:sequenceFlow id="fl_13" name="voltar a aguardar" sourceRef="d5_resub" targetRef="d5_gwe" />
    <bpmn:sequenceFlow id="fl_4" sourceRef="d5_gwe" targetRef="d5_c_notif" />
    <bpmn:sequenceFlow id="fl_5" sourceRef="d5_gwe" targetRef="d5_c_ka" />
    <bpmn:sequenceFlow id="fl_6" sourceRef="d5_gwe" targetRef="d5_c_nav" />
    <bpmn:sequenceFlow id="fl_7" sourceRef="d5_gwe" targetRef="d5_c_close" />
    <bpmn:sequenceFlow id="fl_12" sourceRef="d5_c_nav" targetRef="d5_resub" />
    <bpmn:sequenceFlow id="fl_8" sourceRef="d5_c_notif" targetRef="d5_apply" />
    <bpmn:sequenceFlow id="fl_10" sourceRef="d5_c_ka" targetRef="d5_recover" />
    <bpmn:sequenceFlow id="fl_14" sourceRef="d5_c_close" targetRef="d5_end" />
  </bpmn:process>
  <bpmn:process id="d5_proc_rt" isExecutable="false">
    <bpmn:laneSet id="ls_d5_p_rt">
      <bpmn:lane id="d5_l_rt" name="Distribuição de eventos">
        <bpmn:flowNodeRef>d5_s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_s_wel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_s_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_s_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_s_fan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_s_evt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_s_send_ka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_s_ka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_s_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d5_s_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="d5_s_start" name="Conexão recebida">
      <bpmn:outgoing>fl_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d5_s_start_def" messageRef="message_4" />
    </bpmn:startEvent>
    <bpmn:sendTask id="d5_s_wel" name="Enviar a saudação e os parâmetros da sessão">
      <bpmn:incoming>fl_15</bpmn:incoming>
      <bpmn:outgoing>fl_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="d5_s_gw" name="Aguardar">
      <bpmn:incoming>fl_17</bpmn:incoming>
      <bpmn:incoming>fl_22</bpmn:incoming>
      <bpmn:incoming>fl_24</bpmn:incoming>
      <bpmn:outgoing>fl_18</bpmn:outgoing>
      <bpmn:outgoing>fl_19</bpmn:outgoing>
      <bpmn:outgoing>fl_20</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="d5_s_reg" name="Registrar as assinaturas de tópico da conexão">
      <bpmn:incoming>fl_16</bpmn:incoming>
      <bpmn:outgoing>fl_17</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="d5_s_fan" name="Distribuir o evento a todas as conexões assinantes">
      <bpmn:incoming>fl_21</bpmn:incoming>
      <bpmn:outgoing>fl_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="d5_s_evt" name="Evento publicado em tópico assinado">
      <bpmn:incoming>fl_18</bpmn:incoming>
      <bpmn:outgoing>fl_21</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="d5_s_evt_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="d5_s_send_ka" name="Enviar keepalive">
      <bpmn:incoming>fl_23</bpmn:incoming>
      <bpmn:outgoing>fl_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="d5_s_ka" name="A cada 15 s">
      <bpmn:incoming>fl_19</bpmn:incoming>
      <bpmn:outgoing>fl_23</bpmn:outgoing>
      <bpmn:timerEventDefinition id="d5_s_ka_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="d5_s_close" name="Conexão fechada pelo cliente">
      <bpmn:incoming>fl_20</bpmn:incoming>
      <bpmn:outgoing>fl_25</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d5_s_close_def" messageRef="message_5" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="d5_s_end" name="Assinaturas liberadas">
      <bpmn:incoming>fl_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_15" sourceRef="d5_s_start" targetRef="d5_s_wel" />
    <bpmn:sequenceFlow id="fl_16" sourceRef="d5_s_wel" targetRef="d5_s_reg" />
    <bpmn:sequenceFlow id="fl_17" sourceRef="d5_s_reg" targetRef="d5_s_gw" />
    <bpmn:sequenceFlow id="fl_22" name="voltar a aguardar" sourceRef="d5_s_fan" targetRef="d5_s_gw" />
    <bpmn:sequenceFlow id="fl_24" name="voltar a aguardar" sourceRef="d5_s_send_ka" targetRef="d5_s_gw" />
    <bpmn:sequenceFlow id="fl_18" sourceRef="d5_s_gw" targetRef="d5_s_evt" />
    <bpmn:sequenceFlow id="fl_19" sourceRef="d5_s_gw" targetRef="d5_s_ka" />
    <bpmn:sequenceFlow id="fl_20" sourceRef="d5_s_gw" targetRef="d5_s_close" />
    <bpmn:sequenceFlow id="fl_21" sourceRef="d5_s_evt" targetRef="d5_s_fan" />
    <bpmn:sequenceFlow id="fl_23" sourceRef="d5_s_ka" targetRef="d5_s_send_ka" />
    <bpmn:sequenceFlow id="fl_25" sourceRef="d5_s_close" targetRef="d5_s_end" />
  </bpmn:process>
