<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_D4" targetNamespace="http://unb.fga/G7_ProjetoStreamingVideo" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:escalation id="escalation_0" name="Reprodução não recuperada" escalationCode="Reprodução não recuperada" />
  <bpmn:collaboration id="Collab_D4">
    <bpmn:participant id="d4_p_player" name="Player — recuperação de reprodução" processRef="d4_proc_player" />
    <bpmn:textAnnotation id="d4_n1">
      <bpmn:text>Reencher o buffer é a única ação desta página que o espectador enxerga: é o travamento. Os outros dois ramos existem para agir antes que ele perceba. IMPORTANTE!</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="d4_n2">
      <bpmn:text>Numa transmissão de várias horas o vencimento é certo, não excepcional, por isso é renovado por evento de borda não interruptivo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="d4_n3">
      <bpmn:text>Dois mecanismos de contorno foram observados sem acesso ao código: o pedido ao balanceador declara suporte a reatribuição, e o manifesto mestre carrega URLs alternativas de segmento em outro domínio.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="d4_n4">
      <bpmn:text>Cair para somente áudio é degradação graciosa: uma faixa de ~0,16 Mbit/s da grade permite manter a transmissão viva com quase qualquer rede.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as_d4_n1" associationDirection="None" sourceRef="d4_buf" targetRef="d4_n1" />
    <bpmn:association id="as_d4_n2" associationDirection="None" sourceRef="d4_tok" targetRef="d4_n2" />
    <bpmn:association id="as_d4_n3" associationDirection="None" sourceRef="d4_node" targetRef="d4_n3" />
    <bpmn:association id="as_d4_n4" associationDirection="None" sourceRef="d4_degrade" targetRef="d4_n4" />
  </bpmn:collaboration>
  <bpmn:process id="d4_proc_player" isExecutable="false">
    <bpmn:laneSet id="ls_d4_p_player">
      <bpmn:lane id="d4_l_diag" name="Diagnóstico">
        <bpmn:flowNodeRef>d4_backoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_diag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="d4_l_acao" name="Ação corretiva">
        <bpmn:flowNodeRef>d4_master</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_tok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_node</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_buf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_low</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_gw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_gw3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_degrade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d4_esc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="d4_master" name="Reobter o manifesto mestre">
      <bpmn:incoming>fl_6</bpmn:incoming>
      <bpmn:outgoing>fl_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d4_tok" name="Renovar o token de reprodução">
      <bpmn:incoming>fl_3</bpmn:incoming>
      <bpmn:outgoing>fl_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d4_node" name="Pedir reatribuição de nó ao balanceador">
      <bpmn:incoming>fl_4</bpmn:incoming>
      <bpmn:outgoing>fl_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="d4_alt" name="Usar a URL alternativa declarada no manifesto">
      <bpmn:incoming>fl_7</bpmn:incoming>
      <bpmn:outgoing>fl_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="d4_buf" name="Pausar e reencher o buffer">
      <bpmn:incoming>fl_2</bpmn:incoming>
      <bpmn:outgoing>fl_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="d4_low" name="Descer para a faixa mais baixa disponível">
      <bpmn:incoming>fl_5</bpmn:incoming>
      <bpmn:outgoing>fl_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="d4_join" name="Aguardar as correções disparadas">
      <bpmn:incoming>fl_8</bpmn:incoming>
      <bpmn:incoming>fl_9</bpmn:incoming>
      <bpmn:incoming>fl_10</bpmn:incoming>
      <bpmn:outgoing>fl_11</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="d4_retry" name="Retomar o download na borda da janela">
      <bpmn:incoming>fl_11</bpmn:incoming>
      <bpmn:outgoing>fl_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="d4_gw2" name="Reprodução retomada?">
      <bpmn:incoming>fl_12</bpmn:incoming>
      <bpmn:outgoing>fl_13</bpmn:outgoing>
      <bpmn:outgoing>fl_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="d4_ok" name="Reprodução retomada">
      <bpmn:incoming>fl_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="d4_gw3" name="Ainda há tentativas?">
      <bpmn:incoming>fl_14</bpmn:incoming>
      <bpmn:outgoing>fl_15</bpmn:outgoing>
      <bpmn:outgoing>fl_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="d4_backoff" name="Esperar com recuo exponencial">
      <bpmn:incoming>fl_15</bpmn:incoming>
      <bpmn:outgoing>fl_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="d4_backoff_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R3/PT1S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:inclusiveGateway id="d4_gw" name="Quais modos de falha se aplicam?">
      <bpmn:incoming>fl_1</bpmn:incoming>
      <bpmn:outgoing>fl_2</bpmn:outgoing>
      <bpmn:outgoing>fl_3</bpmn:outgoing>
      <bpmn:outgoing>fl_4</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:businessRuleTask id="d4_diag" name="Classificar o modo de falha">
      <bpmn:incoming>fl_0</bpmn:incoming>
      <bpmn:incoming>fl_16</bpmn:incoming>
      <bpmn:outgoing>fl_1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:startEvent id="d4_start" name="Falha de reprodução detectada">
      <bpmn:outgoing>fl_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="d4_degrade" name="Cair para somente áudio">
      <bpmn:incoming>fl_17</bpmn:incoming>
      <bpmn:outgoing>fl_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="d4_esc" name="Falha reportada ao espectador">
      <bpmn:incoming>fl_18</bpmn:incoming>
      <bpmn:escalationEventDefinition id="d4_esc_def" escalationRef="escalation_0" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="fl_6" sourceRef="d4_tok" targetRef="d4_master" />
    <bpmn:sequenceFlow id="fl_9" sourceRef="d4_master" targetRef="d4_join" />
    <bpmn:sequenceFlow id="fl_3" name="token vencido ou recusado" sourceRef="d4_gw" targetRef="d4_tok">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">token vencido ou recusado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_4" name="nó ou PoP indisponível" sourceRef="d4_gw" targetRef="d4_node">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nó ou PoP indisponível</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_7" sourceRef="d4_node" targetRef="d4_alt" />
    <bpmn:sequenceFlow id="fl_10" sourceRef="d4_alt" targetRef="d4_join" />
    <bpmn:sequenceFlow id="fl_2" name="buffer esgotado" sourceRef="d4_gw" targetRef="d4_buf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">buffer esgotado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_5" sourceRef="d4_buf" targetRef="d4_low" />
    <bpmn:sequenceFlow id="fl_8" sourceRef="d4_low" targetRef="d4_join" />
    <bpmn:sequenceFlow id="fl_11" sourceRef="d4_join" targetRef="d4_retry" />
    <bpmn:sequenceFlow id="fl_12" sourceRef="d4_retry" targetRef="d4_gw2" />
    <bpmn:sequenceFlow id="fl_13" name="sim" sourceRef="d4_gw2" targetRef="d4_ok">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_14" name="não" sourceRef="d4_gw2" targetRef="d4_gw3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_15" name="sim" sourceRef="d4_gw3" targetRef="d4_backoff">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sim</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_17" name="não" sourceRef="d4_gw3" targetRef="d4_degrade">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">não</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="fl_16" name="nova tentativa" sourceRef="d4_backoff" targetRef="d4_diag" />
    <bpmn:sequenceFlow id="fl_1" sourceRef="d4_diag" targetRef="d4_gw" />
    <bpmn:sequenceFlow id="fl_0" sourceRef="d4_start" targetRef="d4_diag" />
    <bpmn:sequenceFlow id="fl_18" sourceRef="d4_degrade" targetRef="d4_esc" />
  </bpmn:process>
